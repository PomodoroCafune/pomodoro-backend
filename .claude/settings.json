{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(openspec:*)",
      "Bash(codegraph:*)",
      "Bash(rtk gain:*)",
      "Bash(git status:*)",
      "Bash(rtk git status:*)",
      "Bash(git diff:*)",
      "Bash(rtk git diff:*)",
      "Bash(git log:*)",
      "Bash(rtk git log:*)",
      "Bash(git fetch:*)",
      "Bash(rtk git fetch:*)",
      "Bash(git check-ignore:*)",
      "mcp__codegraph"
    ],
    "deny": [
      "PowerShell",
      "Bash(git commit:*)",
      "Bash(rtk git commit:*)",
      "Bash(git push:*)",
      "Bash(rtk git push:*)",
      "Read(./.env)"
    ]
  }
}
